<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Back Icon (fixed, outside scroll) -->


    <ImageView
        android:id="@+id/backIcon"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true"
        android:backgroundTint="@color/back_icon_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/outline_arrow_back_ios_24" />
    <TextView
        android:id="@+id/TextdeviceDetailsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="54dp"
        android:layout_marginTop="8dp"
        android:text="Device Details"
        android:textColor="@color/colorTextPrimary"
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@+id/backIcon"
        app:layout_constraintTop_toTopOf="parent" />
    <!-- Device Details Title (fixed, outside scroll) -->

    <!-- Everything else scrolls -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@+id/TextdeviceDetailsText"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Device Image -->
            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                app:srcCompat="@drawable/light_bulb_icon"
                app:tint="@color/blue_accent"/>

            <!-- Device Name -->
            <TextView
                android:id="@+id/textdeviceDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Living room lamp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="28sp"
                android:layout_marginTop="8dp"/>
            <TextView
                android:id="@+id/textDevicePlace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:text="Place"
                android:textColor="?attr/colorOnSurface"
                android:textSize="22sp" />

            <!-- Status -->
            <TextView
                android:id="@+id/textViewStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Status"
                android:textStyle="bold"
                android:textColor="@color/utilitesElementsBlue"
                android:textSize="20sp" />

            <!-- Turn On Button -->
             <LinearLayout
                android:id="@+id/linearLayoutButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:weightSum="2">


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/timeButtonShortInt"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="16dp"
                    android:minHeight="56sp"
                    android:padding="15dp"
                    android:layout_weight="1"
                    android:text="Turn On"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/short_interval_image"
                    app:iconGravity="textStart"
                    app:iconSize="30dp"
                    app:iconTint="@color/utilitesElementsBlue"
                    app:iconPadding="8dp"/>

                 <com.google.android.material.button.MaterialButton
                     android:id="@+id/timeButtonLongInt"
                     style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                     android:layout_width="match_parent"
                     android:layout_height="wrap_content"
                     android:layout_gravity="center_horizontal"
                     android:layout_marginStart="16dp"
                     android:layout_marginTop="12dp"
                     android:layout_marginEnd="16dp"
                     android:minHeight="56sp"
                     android:padding="15dp"
                     android:layout_weight="1"
                     android:text="Turn On"
                     android:textColor="?attr/colorOnSurface"
                     android:textSize="15sp"
                     app:cornerRadius="8dp"
                     app:icon="@drawable/long_interval_image"
                     app:iconGravity="textStart"
                     app:iconSize="30dp"
                     app:iconTint="@color/utilitesElementsBlue"
                     app:iconPadding="8dp"/>

             </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/timeButtonTurnOff"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="16dp"
                android:minHeight="56sp"
                android:padding="15dp"
                android:text="Turn Device Off"
                android:textColor="@color/turnOffBtnText"
                android:textSize="15sp"
                app:backgroundTint="@color/turnOffBtn"
                app:cornerRadius="14dp" />
            <!-- Last Restart + Signal Cards + IP card + MAC adress card -->
            <!-- Two rows of two cards each -->
            <LinearLayout
                android:id="@+id/linearLayoutCardElements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <!--UP TIME + NETWORK-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <!-- Card 1 - UP TIME -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/materialCardView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:minHeight="120dp"
                        app:backgroundTint="@color/toggle_bg_selector"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="4dp"
                        app:strokeColor="@color/card_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:id="@+id/icon"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:src="@drawable/restart_image"
                                    app:tint="@color/blue_accent" />

                                <TextView
                                    android:id="@+id/titleText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="UP TIME"
                                    android:textSize="14sp"
                                    android:letterSpacing="0.08"
                                    android:textColor="@color/text_secondary_dark" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/dateText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:text="Oct 24"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorTextPrimary" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Card 2 - NETWORK -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:minHeight="120dp"
                        app:backgroundTint="@color/toggle_bg_selector"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="4dp"
                        app:strokeColor="@color/card_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/wifiIcon"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:src="@drawable/wifi_image"
                                    app:tint="@color/blue_accent" />

                                <TextView
                                    android:id="@+id/textViewNetworkName"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:letterSpacing="0.08"
                                    android:text="NETWORK"
                                    android:textColor="@color/text_secondary_dark"
                                    android:textSize="14sp" />

                            </LinearLayout>

                            <!-- Percentage -->
                            <TextView
                                android:id="@+id/textViewSignalStrength"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="97%"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <!-- Signal Bars -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:gravity="bottom"
                                android:orientation="horizontal">

                                <View style="@style/SignalBar" android:layout_height="6dp" />
                                <View style="@style/SignalBar" android:layout_height="10dp" />
                                <View style="@style/SignalBar" android:layout_height="14dp" />
                                <View style="@style/SignalBar" android:layout_height="18dp" />

                            </LinearLayout>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- IP + MAC address -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginTop="16dp">

                    <!-- Card 3 - IP ADDRESS -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/material_card_IP"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:minHeight="120dp"
                        app:backgroundTint="@color/toggle_bg_selector"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="4dp"
                        app:strokeColor="@color/card_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <!-- Header -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:id="@+id/ipIcon"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:src="@drawable/restart_image"
                                    app:tint="@color/blue_accent" />

                                <TextView
                                    android:id="@+id/ipTitleText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="IP ADDRESS"
                                    android:textSize="14sp"
                                    android:letterSpacing="0.08"
                                    android:textColor="@color/text_secondary_dark" />

                            </LinearLayout>

                            <!-- Value -->
                            <TextView
                                android:id="@+id/textViewIP"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:text="192.168.1.1"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorTextPrimary" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Card 4 - MAC ADDRESS -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/material_card_MAC"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:minHeight="120dp"
                        app:backgroundTint="@color/toggle_bg_selector"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="4dp"
                        app:strokeColor="@color/card_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <!-- Header -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:id="@+id/macIcon"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:src="@drawable/restart_image"
                                    app:tint="@color/blue_accent" />

                                <TextView
                                    android:id="@+id/macTitleText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="MAC ADDRESS"
                                    android:textSize="14sp"
                                    android:letterSpacing="0.08"
                                    android:textColor="@color/text_secondary_dark" />

                            </LinearLayout>

                            <!-- Value -->
                            <TextView
                                android:id="@+id/textViewMAC"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:text="00:1A:2B:3C"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorTextPrimary" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </LinearLayout>

                <!-- Activity Log Title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/imgManualActivation"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/touch_manual_device_icon"
                    app:tint="@color/colorPrimary" />

                <TextView
                    android:id="@+id/textdeviceDetails3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"

                    android:text="Activity log"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>


            <!-- Manual Activation Row -->
            <!-- Schedules Table Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="0dp"
                    >

                    <!-- Table Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        app:cardBackgroundColor="@color/toggle_bg_selector"
                        >

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="STATUS"
                            android:textColor="#8FA3AD"
                            android:textSize="12sp"
                            android:gravity="center"
                            />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="REASON"
                            android:textColor="#8FA3AD"
                            android:textSize="12sp"
                            android:gravity="center"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="DATE"
                            android:textColor="#8FA3AD"
                            android:textSize="12sp"
                            android:gravity="center"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="PASSED"
                            android:textColor="#8FA3AD"
                            android:textSize="12sp"
                            android:gravity="center"
                            />

                    </LinearLayout>

                    <!-- Header Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/divider_color" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:padding="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />


                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <!-- Scheduled Off Row -->
<!--            <LinearLayout-->
<!--                android:id="@+id/containerScheduledOff"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="64dp"-->
<!--                android:layout_marginStart="16dp"-->
<!--                android:layout_marginEnd="16dp"-->
<!--                android:gravity="center_vertical"-->
<!--                android:orientation="horizontal">-->

<!--               -->

<!--                <LinearLayout-->
<!--                    android:layout_width="0dp"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:layout_weight="1"-->
<!--                    android:layout_marginStart="12dp"-->
<!--                    android:orientation="vertical">-->

<!--                    <TextView-->
<!--                        android:id="@+id/textViewScheduledOff"-->
<!--                        android:layout_width="wrap_content"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:text="Scheduled Off"-->
<!--                        android:textColor="?attr/colorOnSurface"-->
<!--                        android:textSize="14sp"-->
<!--                        android:textStyle="bold" />-->

<!--                    <TextView-->
<!--                        android:id="@+id/textViewTime"-->
<!--                        android:layout_width="wrap_content"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:text="08:00 AM"-->
<!--                        android:textColor="#8FA3AD"-->
<!--                        android:textSize="12sp" />-->

<!--                </LinearLayout>-->
<!--            </LinearLayout>-->

            <!-- Schedules Title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/imgClock"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/timer_off_icon"
                    app:tint="@color/colorPrimary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Schedules"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginLeft="8dp"/>

<!--                <TextView-->
<!--                    android:id="@+id/tvEditSchedule"-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:text="Edit"-->
<!--                    android:textColor="@color/colorPrimary"-->
<!--                    android:textSize="14sp" />-->

            </LinearLayout>

            <!-- Schedules Table Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Table Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:cardBackgroundColor="@color/toggle_bg_selector">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="START"
                            android:textColor="#8FA3AD"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="END"
                            android:textColor="#8FA3AD"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="DURATION"
                            android:textColor="#8FA3AD"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <!-- Header Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/divider_color" />

                    <!-- Row 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp"
                        app:cardBackgroundColor="@color/toggle_bg_selector">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/textViewStartTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="06:00 AM"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/textViewTimeEnd1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="08:30 AM"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textViewDuration1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="2h 30m"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <!-- Row Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/divider_color" />

                    <!-- Row 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/textViewStartTime2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="06:30 PM"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

